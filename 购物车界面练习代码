dict1={}
while True:
    print("欢迎使用购物车管理系统")
    print("########## 购物车系统 ##########\n")
    print("#        1. 添加购物车        #")
    print("#        2. 修改购物车        #")
    print("#        3. 删除购物车        #")
    print("#        4. 查询购物车        #")
    print("#        5. 退出购物车        #\n")
    print("##############################")
    choice=int(input("请选择要执行的操作(1-5):"))

    if choice==1 or choice==2:
        dict_key=input("请输入商品名称:")
        price=float (input("请输入商品金额:"))
        count=int(input("请输入商品数量:"))
        dict1[dict_key]={
            "价格":price,
            "数量":count
        }
        for name, information in dict1.items():
            print(name, information)
    if choice==3:
        dict_key = input("请输入商品名称:")
        del dict1[dict_key]
        print(f"已删除:{dict_key}")
    if choice==4:
        for name, information in dict1.items():
            print(name, information)
    if choice==5:
        print("已退出购物车")
